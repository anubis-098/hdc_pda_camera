HOST=0.0.0.0
PORT=8090
COMPOSE_HTTP_PORT=8083
BIND_ADDRESS=127.0.0.1
HDC_TLS_DIRECTORY=D:/HDC-Certificates
CORS_ORIGIN=*
# Node.js on Windows uses the UNC path. Compose overrides STORAGE_ROOT.
STORAGE_ROOT=\\CJITADMINSERVER\Scanner\PDA-Camera
# For direct Compose commands, set the existing local Windows directory behind the share.
# STORAGE_HOST_PATH=D:/Shares/Scanner/PDA-Camera
INBOUND_DIR=Inbound
RETURN_DIR=Return
OUTBOUND_DIR=Outbound
OTHER_DIR=Other
MAX_FILE_SIZE_MB=10
STORAGE_USERNAME=
STORAGE_PASSWORD=
HTTPS_ENABLED=false
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=
