HOST=0.0.0.0
PORT=8090
CORS_ORIGIN=*
# Path inside the container. Mount the Ubuntu host folder with STORAGE_HOST_PATH.
STORAGE_ROOT=/data/uploads
STORAGE_HOST_PATH=/mnt/pda-camera
RETURN_DIR=Return
OUTBOUND_DIR=Outbound
OTHER_DIR=Other
MAX_FILE_SIZE_MB=10
STORAGE_USERNAME=
STORAGE_PASSWORD=
HTTPS_ENABLED=false
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=
