HOST=0.0.0.0
PORT=8090
COMPOSE_HTTP_PORT=8083
# Used by the optional Compose HTTPS profile.
PDA_HTTPS_HOSTNAME=pda-camera.local
PDA_HTTPS_BIND_ADDRESS=0.0.0.0
PDA_CERT_DIR=./certs
# Windows server example: PDA_CERT_DIR=D:/HDC-Certificates
CORS_ORIGIN=*
# Path inside the container. Mount the Ubuntu host folder with STORAGE_HOST_PATH.
# For Node.js on Windows, use STORAGE_ROOT=\\CJITADMINSERVER\Scanner\PDA-Camera
STORAGE_ROOT=/data/uploads
STORAGE_HOST_PATH=/mnt/pda-camera
INBOUND_DIR=Inbound
RETURN_DIR=Return
OUTBOUND_DIR=Outbound
OTHER_DIR=Other
MAX_FILE_SIZE_MB=10
STORAGE_USERNAME=
STORAGE_PASSWORD=
HTTPS_ENABLED=false
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=
