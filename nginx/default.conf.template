server {
    listen 80;
    server_name ${PDA_HTTPS_HOSTNAME};
    return 308 https://${PDA_HTTPS_HOSTNAME}$request_uri;
}

server {
    listen 443 ssl;
    server_name ${PDA_HTTPS_HOSTNAME};

    ssl_certificate     /etc/nginx/certs/pda-camera.pem;
    ssl_certificate_key /etc/nginx/certs/pda-camera-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Allow multipart overhead on top of Fastify's default 10 MiB file limit.
    client_max_body_size 11m;

    location / {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $pda_upstream pda-camera:8090;
        proxy_pass http://$pda_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
